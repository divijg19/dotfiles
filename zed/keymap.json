[
  // New untitled file (VS Code: alt+n → workbench.action.files.newUntitledFile)
  {
    "context": "Workspace",
    "bindings": {
      "alt-n": "workspace::NewFile"
    }
  },
  // Close/kill current terminal (VS Code: ctrl+shift+delete → workbench.action.terminal.kill)
  // In Zed, this closes the terminal pane when focused.
  {
    "context": "Terminal",
    "bindings": {
      "ctrl-shift-delete": "pane::CloseActiveItem"
    }
  }
]