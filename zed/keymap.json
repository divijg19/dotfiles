[
  // Open Ghostty for actual development
  // (overrides default ctrl-~ → workspace::NewTerminal)
  {
    "context": "Workspace",
    "bindings": {
      "ctrl-~": ["task::Spawn", { "task_name": "Open Project Shell" }]
    }
  },
  // ── Keep ──
  // Kill/close terminal pane (explicit workflow preference)
  {
    "context": "Terminal",
    "bindings": {
      "ctrl-shift-delete": "pane::CloseActiveItem"
    }
  }
]