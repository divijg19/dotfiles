#!/bin/sh
#
# update-go-tools: Inspect, inventory, and update Go tools installed via `go install`
# Version: 1.2.0
#
# ARCHITECTURE:
#   - Single discovery engine emitting structured tool records (parsing metadata once).
#   - Explicit error handling and structured exit codes.
#   - Support for inventory, inspection (--info), verification (--verify), and positional tool updates.

set -eu

VERSION="1.2.0"

# Exit codes
EXIT_SUCCESS=0
EXIT_FAILURE=1
EXIT_USAGE=2
EXIT_ENV=3

die() {
    printf "Error: %s\n" "$1" >&2
    exit "$2"
}

print_header() {
    go_version=$(go env GOVERSION)
    printf "Go: %s\n\n" "$go_version"
}

print_help() {
    cat <<EOF
update-go-tools $VERSION - Inspect, inventory, and update Go-managed tools

Usage:
    update-go-tools [tool...]
    update-go-tools --list
    update-go-tools --info <tool>
    update-go-tools --verify
    update-go-tools --help
    update-go-tools --version

Options:
    --help       Display this help message
    --version    Display version information
    --list       List inventory of all Go-managed tools with versions and modules
    --info       Show detailed metadata for a specific tool
    --verify     Verify integrity of installed Go tools without updating

Without arguments, updates all discovered Go tools.
With one or more tool names, updates only those specified tools.
EOF
}

print_version() {
    printf "update-go-tools %s\n" "$VERSION"
}

discover_gobin() {
    gobin_dir=$(go env GOBIN)
    if [ -z "$gobin_dir" ]; then
        gobin_path=$(go env GOPATH)
        [ -z "$gobin_path" ] && die "GOPATH is not set and GOBIN is empty." "$EXIT_ENV"
        gobin_dir="$gobin_path/bin"
    fi
    [ ! -d "$gobin_dir" ] && die "Go bin directory '$gobin_dir' does not exist." "$EXIT_ENV"
    printf "%s" "$gobin_dir"
}

discover_tools() {
    gobin_dir="$1"
    for tool_path in "$gobin_dir"/*; do
        [ -f "$tool_path" ] && [ -x "$tool_path" ] || continue

        if meta=$(go version -m "$tool_path" 2>/dev/null); then
            package_path=$(printf "%s\n" "$meta" | awk '$1=="path"{print $2}')
            version=$(printf "%s\n" "$meta" | awk '$1=="mod"{print $3}')
            [ -z "$version" ] && version="unknown"

            if [ -n "$package_path" ]; then
                tool_name=$(basename "$tool_path")
                printf "%s|%s|%s|%s\n" "$tool_name" "$package_path" "$tool_path" "$version"
            fi
        fi
    done | sort
}

print_inventory() {
    gobin_dir="$1"
    printf "%-20s %-15s %s\n" "NAME" "VERSION" "MODULE"
    printf "%-20s %-15s %s\n" "----" "-------" "------"
    discover_tools "$gobin_dir" | while IFS='|' read -r tool_name package_path tool_path version; do
        [ -n "$tool_name" ] || continue
        printf "%-20s %-15s %s\n" "$tool_name" "$version" "$package_path"
    done
}

print_tool_info() {
    gobin_dir="$1"
    target_tool="$2"

    disc_file=$(mktemp 2>/dev/null || mktemp -t 'update-go-tools-disc.XXXXXX')
    discover_tools "$gobin_dir" > "$disc_file"

    found=0
    while IFS='|' read -r tool_name package_path tool_path version; do
        [ "$tool_name" = "$target_tool" ] || continue
        found=1
        go_ver=$(go env GOVERSION)
        printf "Binary\n\n  %s\n\n" "$tool_name"
        printf "Module\n\n  %s\n\n" "$package_path"
        printf "Version\n\n  %s\n\n" "$version"
        printf "Go\n\n  %s\n\n" "$go_ver"
        printf "Location\n\n  %s\n" "$tool_path"
        break
    done < "$disc_file"
    rm -f "$disc_file"

    if [ "$found" -eq 0 ]; then
        die "Tool '$target_tool' not found or has no module metadata." "$EXIT_USAGE"
    fi
}

verify_tools() {
    gobin_dir="$1"
    disc_file=$(mktemp 2>/dev/null || mktemp -t 'update-go-tools-disc.XXXXXX')
    discover_tools "$gobin_dir" > "$disc_file"

    count=0
    while IFS='|' read -r tool_name package_path tool_path version; do
        [ -n "$tool_name" ] || continue
        if [ -f "$tool_path" ] && [ -x "$tool_path" ]; then
            printf "✓ %-15s (%s)\n" "$tool_name" "$version"
            count=$((count + 1))
        else
            printf "✗ %-15s (not executable or missing)\n" "$tool_name" >&2
        fi
    done < "$disc_file"
    rm -f "$disc_file"

    printf "\n%d tools verified.\n" "$count"
}

update_tools() {
    gobin_dir="$1"
    shift
    target_tools="$*"

    print_header

    updated_count=0
    skipped_count=0
    failed_count=0
    failed_list=""

    disc_file=$(mktemp 2>/dev/null || mktemp -t 'update-go-tools-disc.XXXXXX')
    discover_tools "$gobin_dir" > "$disc_file"

    total_files=0
    for f in "$gobin_dir"/*; do
        [ -f "$f" ] && [ -x "$f" ] && total_files=$((total_files + 1))
    done

    go_tools_count=0

    while IFS='|' read -r tool_name package_path tool_path version; do
        [ -n "$tool_name" ] || continue
        go_tools_count=$((go_tools_count + 1))

        if [ -n "$target_tools" ]; then
            match=0
            for t in $target_tools; do
                [ "$t" = "$tool_name" ] && match=1 && break
            done
            [ "$match" -eq 0 ] && continue
        fi

        printf "Updating %-20s " "$tool_name..."

        if go install "${package_path}@latest"; then
            printf "✓\n"
            updated_count=$((updated_count + 1))
        else
            printf "✗\n"
            failed_count=$((failed_count + 1))
            if [ -z "$failed_list" ]; then
                failed_list="- $tool_name"
            else
                failed_list="$failed_list
- $tool_name"
            fi
        fi
    done < "$disc_file"

    rm -f "$disc_file"

    skipped_count=$((total_files - go_tools_count))

    printf "\n"
    printf "Updated:  %d\n" "$updated_count"
    if [ "$skipped_count" -gt 0 ]; then
        printf "Skipped:  %d\n" "$skipped_count"
    fi
    if [ "$failed_count" -gt 0 ]; then
        printf "Failed:   %d\n" "$failed_count"
        printf "\nFailed tools:\n%s\n" "$failed_list"
        exit "$EXIT_FAILURE"
    fi
}

main() {
    if ! command -v go >/dev/null 2>&1; then
        die "'go' is not installed or not in PATH." "$EXIT_ENV"
    fi

    gobin_dir=$(discover_gobin)

    if [ $# -gt 0 ]; then
        case "$1" in
            --help|-h)
                print_help
                exit "$EXIT_SUCCESS"
                ;;
            --version|-v)
                print_version
                exit "$EXIT_SUCCESS"
                ;;
            --list)
                print_inventory "$gobin_dir"
                exit "$EXIT_SUCCESS"
                ;;
            --verify)
                verify_tools "$gobin_dir"
                exit "$EXIT_SUCCESS"
                ;;
            --info)
                if [ $# -lt 2 ]; then
                    die "Option --info requires a tool name." "$EXIT_USAGE"
                fi
                print_tool_info "$gobin_dir" "$2"
                exit "$EXIT_SUCCESS"
                ;;
            -*)
                die "Unknown option: $1. Run 'update-go-tools --help' for usage." "$EXIT_USAGE"
                ;;
        esac
    fi

    update_tools "$gobin_dir" "$@"
}

main "$@"
